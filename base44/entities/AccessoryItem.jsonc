{
  "name": "AccessoryItem",
  "type": "object",
  "properties": {
    "po_id": {
      "type": "string",
      "description": "Reference to PurchaseOrder"
    },
    "po_number": {
      "type": "string"
    },
    "article_name": {
      "type": "string"
    },
    "article_code": {
      "type": "string"
    },
    "packing_type": {
      "type": "string",
      "enum": [
        "Sheet Pack",
        "Roll Pack",
        "Box Pack"
      ],
      "description": "Packaging type this item belongs to",
      "default": "Sheet Pack"
    },
    "category": {
      "type": "string",
      "enum": [
        "Zipper",
        "Slider",
        "Elastic",
        "Button",
        "Dori",
        "Eyelet",
        "Stitching Thread",
        "Insert Card",
        "Label",
        "Accessory",
        "Polybag",
        "Stiffener",
        "Carton",
        "Sticker",
        "Other"
      ],
      "default": "Other"
    },
    "item_description": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "size_spec": {
      "type": "string",
      "description": "Size or specification"
    },
    "quantity_required": {
      "type": "number"
    },
    "wastage_percent": {
      "type": "number"
    },
    "multiplier": {
      "type": "number",
      "description": "Quantity multiplier (e.g. labels per piece)",
      "default": 1
    },
    "pc_ean_code": {
      "type": "string",
      "description": "Per-piece EAN/barcode"
    },
    "carton_ean_code": {
      "type": "string",
      "description": "Per-carton EAN/barcode"
    },
    "unit": {
      "type": "string",
      "enum": [
        "Pcs",
        "Meters",
        "Kgs",
        "Rolls",
        "Dozens",
        "Gross",
        "Sets"
      ],
      "default": "Pcs"
    },
    "consumption_per_unit": {
      "type": "number"
    },
    "supplier": {
      "type": "string"
    },
    "unit_cost": {
      "type": "number"
    },
    "total_cost": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Planned",
        "Ordered",
        "Received",
        "Approved"
      ],
      "default": "Planned"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "category",
    "item_description"
  ]
}